complete -c t3 -n '__fish_use_subcommand' -f -a 'trace' -d 'Inspect the local server trace file.'
complete -c t3 -n '__fish_use_subcommand' -f -a 'doctor' -d 'Inspect this T3 Code data directory and repair it. Pauses and restarts the background service as needed.'
