###-begin-t3-completions-###
#
# Static completion script for Fish
#
# Installation:
#   t3 --completions fish > ~/.config/fish/completions/t3.fish
#

complete -c t3 -n '__fish_use_subcommand' -f
complete -c t3 -n '__fish_use_subcommand' -f -a 'help' -d 'Show command help.'
complete -c t3 -n '__fish_use_subcommand' -f -a 'start' -d 'Run the T3 Code server.'
complete -c t3 -n '__fish_use_subcommand' -f -a 'serve' -d 'Run the T3 Code server without opening a browser and print headless pairing details.'
complete -c t3 -n '__fish_use_subcommand' -f -a 'app' -d 'Open a project in the running T3 Code desktop app.'
complete -c t3 -n '__fish_use_subcommand' -f -a 'pair' -d 'Mint a pairing token for a running T3 Code server and print it as a QR code.'
complete -c t3 -n '__fish_use_subcommand' -f -a 'auth' -d 'Manage the local auth control plane for headless deployments.'
complete -c t3 -n '__fish_use_subcommand' -f -a 'browser' -d 'Manage T3\'s headless browser on this host.'
complete -c t3 -n '__fish_use_subcommand' -f -a 'project' -d 'Manage projects.'
complete -c t3 -n '__fish_use_subcommand' -f -a 'thread' -d 'Start, message, and read threads on the running server.'
complete -c t3 -n '__fish_use_subcommand' -f -a 'service' -d 'Manage the T3 Code background service.'
complete -c t3 -n '__fish_use_subcommand' -f -a 'update' -d 'Download a newer t3 and switch this machine to it, including the background service when one is installed.'
complete -c t3 -n '__fish_use_subcommand' -f -a 'uninstall' -d 'Remove t3 from this machine: the background service, the launcher, and every downloaded version. Your projects and threads are kept.'
